# Its own database on the same MySQL server as LaundryPro (never the laundrypro database:
# both apps run `prisma db push` on start and would drop each other's tables)
DATABASE_URL="mysql://petpro:CHANGE_ME@127.0.0.1:3306/petpro"

# Required: the app will not start without it. Signs the session cookie; at least 32 random
# characters, different from LaundryPro's
SESSION_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# Optional: better address lookup for the pet taxi route (otherwise OpenStreetMap Nominatim)
GOOGLE_MAPS_API_KEY=""

# Where work-order photos are kept; give it a persistent volume in Coolify
PHOTOS_DIR="storage/photos"

# Public address, also sent to the address lookup service as identification
APP_URL=""

# Public demo mode: "true" fills the shared demo salon at start, resets it every night at
# 03:00 Turkey time. Businesses that sign up are not touched
AUTO_SEED=""

# The owner's list of signed-up businesses: /yonetim?key=<value>. At least 16 characters;
# without it the page does not exist
ADMIN_KEY=""
